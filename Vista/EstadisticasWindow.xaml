<Window x:Class="WPF_Test.Vista.EstadisticasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:WPF_Test.Vista"
        mc:Ignorable="d"
        Title="Estadisticas" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Cantidad de servicios realizados (Órdenes de Trabajo)"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <sp:WpfPlot x:Name="PlotServicios" Grid.Row="1"/>
    </Grid>
</Window>
