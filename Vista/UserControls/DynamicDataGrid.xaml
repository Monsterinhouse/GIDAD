<UserControl x:Class="WPF_Test.Vista.UserControls.DynamicDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Test.Vista.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <DataGrid x:Name="InnerGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              HorizontalGridLinesBrush="Gray"
              VerticalGridLinesBrush="Gray"
              SelectionUnit="Cell"
              AlternationCount="2"
              RowBackground="White"
              AlternatingRowBackground="LightGray"
              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Rows}"
              >
        <DataGrid.Resources>
            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderThickness" Value="0,0,1.5,1.5"/>
                <Setter Property="BorderBrush" Value="Black"/>
                <Setter Property="FontStyle" Value="Italic"/>
                <Setter Property="FontFamily" Value="Instagram Sans"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
        </DataGrid.Resources>
    </DataGrid>
    
</UserControl>
