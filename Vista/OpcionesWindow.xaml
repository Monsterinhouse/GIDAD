<Window x:Class="WPF_Test.Vista.OpcionesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Test.Vista"
        mc:Ignorable="d"
        Title="Opciones" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="20" VerticalAlignment="Center">

        <TextBlock Text="Intervalo de autoguardado (minutos):"
                   FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtIntervalo" Width="80" HorizontalAlignment="Left"
                 FontSize="14" Padding="4"/>

        <Separator Margin="0,16"/>

        <TextBlock Text="Guardado definitivo:"
                   FontWeight="Bold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Guardar ahora en BD"
                    Click="BtnGuardarAhora_Click"
                    Padding="8,4" Margin="0,0,10,0"/>
            <Button Content="Elegir carpeta de destino"
                    Click="BtnElegirCarpeta_Click"
                    Padding="8,4"/>
        </StackPanel>

        <Separator Margin="0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Click="BtnCancelar_Click"
                    Padding="8,4" Margin="0,0,10,0"/>
            <Button Content="Guardar configuración" Click="BtnGuardar_Click"
                    Padding="8,4" FontWeight="Bold"/>
        </StackPanel>

    </StackPanel>

</Window>
